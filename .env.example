# AURA Vision AI Scanner Environment Configuration
# Copy this file to '.env' in the same directory and enter your API keys.

# Primary Multimodal LLM: Google Gemini API Key
# Recommended for fast, stable, and accurate fashion object detection.
# Create a free API key at: https://aistudio.google.com/
EXPO_PUBLIC_GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Backup Multimodal LLM: Hugging Face Access Token (Read-Only)
# Create a free token at https://huggingface.co/settings/tokens
EXPO_PUBLIC_HF_TOKEN=hf_yourHuggingFaceTokenHere

# Optional: Remove.bg API Key for transparent background extraction.
# Create a free account at https://www.remove.bg/ to get 50 free images/month.
# Paste your API key here to automatically remove the background from uploaded clothes images.
EXPO_PUBLIC_REMOVE_BG_API_KEY=yourRemoveBgApiKeyHere
